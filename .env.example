# ---------------------------------------------------------------------------
# Backend SixSence — copie ce fichier en ".env" pour le développement local.
# Sur Render, ces valeurs se saisissent dans Environment > Environment Variables.
# ---------------------------------------------------------------------------

# Supabase : Project Settings > API Keys
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé SECRÈTE (sb_secret_...). Elle contourne toutes les règles de sécurité :
# jamais dans le front, jamais dans un fichier commité.
# (L'ancien nom SUPABASE_KEY est aussi accepté.)
SUPABASE_SERVICE_ROLE_KEY=

# Origines autorisées à appeler l'API, séparées par des virgules (* accepté en joker).
# Par défaut : sixsence.fr, www.sixsence.fr, les adresses Vercel du site et localhost:3000.
# CORS_ORIGINS=http://localhost:3000

# Port d'écoute. Render le fournit automatiquement.
PORT=4000

# --- Réglages du classé COD (tous facultatifs) ------------------------------
# Files classées proposées, séparées par des virgules (format NvN, de 1v1 à 5v5).
# COD_FORMATS=2v2,3v3,4v4,5v5
# Ajoute une file de test « NvN (test) » en plus, ex. 1 pour tester un match à deux comptes.
# COD_TEAM_SIZE=1
# Cartes et modes tirés au hasard, séparés par des virgules.
# COD_MAPS=Babylon,Derelict,Lowtown,Payback,Protocol,Red Card,Rewind,Skyline,Subsonic,Vault,Vorkuta
# COD_MODES=Recherche & Destruction Hardcore
# Un résultat déclaré est validé d'office si l'adversaire ne répond pas (minutes).
COD_CONFIRM_MINUTES=15
# Un match jamais déclaré est annulé au bout de ce délai (minutes).
COD_CANCEL_MINUTES=180
# Temps laissé aux joueurs pour accepter un match trouvé (secondes).
COD_READY_SECONDS=60

# --- Discord (facultatif : tout est désactivé tant que le jeton est vide) -----
# Jeton du bot (Discord Developer Portal > Bot > Reset Token). SECRET.
# Le bot doit être sur le serveur avec les droits « Gérer les salons », « Gérer les rôles » et « Envoyer des messages »,
# et son rôle doit être placé au-dessus des rôles de rang (Bronze … Champion), Player COD et Player GTA.
DISCORD_BOT_TOKEN=
# Identifiant du serveur Discord (mode développeur > clic droit sur le serveur > Copier l'identifiant).
DISCORD_GUILD_ID=
# Catégorie où créer les salons vocaux des matchs (facultatif).
DISCORD_MATCH_CATEGORY_ID=
# Salon où publier les résultats des matchs (facultatif).
DISCORD_RESULTS_CHANNEL_ID=
# Salon privé de l'équipe : demandes d'arbitrage et signalements (facultatif).
DISCORD_STAFF_CHANNEL_ID=
# Salon des annonces COD : file qui se remplit (mention @COD), MVP du mois, fin de saison (facultatif).
DISCORD_COD_CHANNEL_ID=
# Salon des annonces GTA 6 : nouveaux événements, annulations, rappels 1 h avant (facultatif).
DISCORD_GTA_CHANNEL_ID=

# Notifications push : clés VAPID (facultatives — générées et gardées en base au premier démarrage).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Adresse publique du site, pour les liens envoyés sur Discord.
# SITE_URL=https://www.sixsence.fr
