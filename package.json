{
  "name": "sixsence-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Backend SixSence : matchmaking COD classé, événements GTA 6, WebSocket de file d'attente.",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "postinstall": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.12",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "typescript": "^5.6.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
